{
  "openapi": "3.1.0",
  "info": {
    "title": "Archimedes Collaboration API",
    "version": "1.0.0",
    "description": "Contract for async collaboration. Desktop clients remain local-first; the API is the shared write path."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Local/LAN development"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "auth"
    },
    {
      "name": "projects"
    },
    {
      "name": "members"
    },
    {
      "name": "libraries"
    },
    {
      "name": "threads"
    },
    {
      "name": "comments"
    },
    {
      "name": "sync"
    },
    {
      "name": "agent-runs"
    },
    {
      "name": "sharing"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "tags": [
          "auth"
        ],
        "operationId": "health",
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/dev-session": {
      "post": {
        "security": [],
        "tags": [
          "auth"
        ],
        "operationId": "devSession",
        "summary": "Development-only session token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevSessionInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "me",

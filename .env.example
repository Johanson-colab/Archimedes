# Use any OpenAI-compatible Chat Completions provider.
ARCHIMEDES_LLM_API_KEY=
ARCHIMEDES_LLM_BASE_URL=https://api.openai.com/v1
ARCHIMEDES_LLM_MODEL=gpt-4.1-mini

# Optional: enables general web and news search in Research Chat.
# You can also set this from the Web search button in the chat header.
ARCHIMEDES_WEB_SEARCH_API_KEY=

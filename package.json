{
  "name": "archimedes-research",
  "productName": "Archimedes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first AI-for-Research agent for evidence, experiments, and scientific writing.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "desktop": "electron .",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "audit:theme": "node scripts/theme-audit.mjs",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "test": "node --test electron/*.test.cjs electron/agent/*.test.cjs && node scripts/check-theme-tokens.mjs",
    "gallery:build": "python3 scripts/gallery-pipeline.py build",
    "gallery:pool": "python3 scripts/gallery-pipeline.py pool",
    "gallery:extract": "python3 scripts/gallery-pipeline.py extract",
    "gallery:select": "python3 scripts/gallery-pipeline.py select",
    "gallery:sheets": "python3 scripts/gallery-pipeline.py sheets",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "postinstall": "npm run rebuild:native"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^0.1.100",
    "@vitejs/plugin-react": "latest",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.11.0",
    "jsdom": "^29.1.1",
    "katex": "^0.18.4",
    "lucide-react": "latest",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "5.4.624",
    "pptxgenjs": "^3.12.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/react-syntax-highlighter": "^15.5.13",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "typescript": "latest",
    "wait-on": "latest"
  }
}

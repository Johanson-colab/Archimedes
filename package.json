{
  "name": "archimedes-research",
  "productName": "Archimedes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first AI-for-Research agent for evidence, experiments, and scientific writing.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "desktop": "electron .",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "test": "node --test electron/*.test.cjs electron/agent/*.test.cjs",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "postinstall": "npm run rebuild:native"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.11.0",
    "lucide-react": "latest",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "5.4.624",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/react-syntax-highlighter": "^15.5.13",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "typescript": "latest",
    "wait-on": "latest"
  }
}

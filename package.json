{
  "name": "archimedes-research",
  "productName": "Archimedes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first AI-for-Research agent for evidence, experiments, and scientific writing.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "desktop": "node scripts/electron-runtime.cjs --check && electron .",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/electron-runtime.cjs --check && wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "package:desktop": "npm run build && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "verify:package": "node scripts/verify-package.cjs",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac dmg --publish never",
    "lint": "tsc -b --pretty false",
    "audit:theme": "node scripts/theme-audit.mjs",
    "radar:sync": "node scripts/sync-benchmark-radar-index.mjs",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "codemod:theme": "node scripts/codemod-theme-colors.mjs",
    "test": "node scripts/run-tests.cjs --all && node scripts/check-theme-tokens.mjs",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "postinstall": "npm run rebuild:native",
    "server:start": "node server/index.cjs",
    "server:test": "node --test server/*.test.cjs",
    "server:supabase": "node server/index-supabase.cjs",
    "server:lan": "node server/index-lan.cjs",
    "prepare:desktop": "node scripts/electron-runtime.cjs --prepare",
    "check:desktop": "node scripts/electron-runtime.cjs --check",
    "test:core": "node scripts/run-tests.cjs --core",
    "test:desktop": "node scripts/run-tests.cjs --desktop"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@huggingface/transformers": "4.3.2",
    "@lezer/highlight": "^1.2.5",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^0.1.100",
    "@supabase/supabase-js": "^2.118.0",
    "@vitejs/plugin-react": "6.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.11.0",
    "jsdom": "^29.1.1",
    "katex": "^0.18.4",
    "lucide-react": "1.33.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "5.4.624",
    "pptxgenjs": "^3.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "8.2.2",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.18.0",
    "postcss": "^8.5.26",
    "typescript": "7.0.2",
    "wait-on": "9.1.0"
  }
}
